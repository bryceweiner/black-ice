# Identity
ASSISTANT_NAME=Ice
OWNER_NAME=Bryce
# male -> "sir", female -> "ma'am", anything else -> no honorific.
OWNER_GENDER=
# Overrides the mapping above if you want a specific term.
OWNER_HONORIFIC=

# Server
HOST=0.0.0.0
PORT=8080
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
# Generate with: blackice hash-password
ADMIN_PASSWORD_HASH=

# LM Studio
LMSTUDIO_BASE_URL=http://localhost:1234/v1
MODEL_PRIMARY=qwen3.8-27b-abliterated-mlx
MODEL_TRIAGE=qwen3.5-4b-mlx
# Skip the <think> block on triage calls; much faster, no quality cost
# for a one-word verdict.
TRIAGE_NO_THINK=true

# Paths
DATA_DIR=data

# Restart the service when source, prompt or plugin files change.
AUTO_RELOAD=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=blackice.log

# PromptGuard
GUARD_MODEL=meta-llama/Llama-Prompt-Guard-2-86M
GUARD_THRESHOLD=0.5

# Memory
MEMORY_ENABLED=true
KOKORO_MEMORY_ROOT=data/memory
# How often to turn recent conversation and events into durable facts.
MEMORY_CONSOLIDATE_HOURS=6

# RSI — self-editing prompts stay off until the golden set can discriminate
RSI_FEEDBACK_ENABLED=true
RSI_PROPOSALS_ENABLED=true
RSI_SELF_EDIT_ENABLED=false
# The daily self-review always runs; the flag above decides whether a
# candidate that beats the incumbent goes live or waits for approval.
RSI_REVIEW_ENABLED=true
RSI_REVIEW_HOURS=24
RSI_GOLDEN_SET_MIN=50

# Retention in days; blank means forever
RETAIN_MEDIA_DAYS=30
RETAIN_EVENTS_DAYS=365
RETAIN_LLM_DAYS=

# Clock plugin — blank uses whatever this machine is set to
CLOCK_TIMEZONE=
# How late a reminder may still be announced after the service was down.
# Anything older is marked missed instead of shouted hours late.
CLOCK_REMINDER_GRACE_MINUTES=60

# V380 cameras — credentials applied to every camera found on the LAN.
# Blank means cameras are discovered and listed but never connected to.
# Several V380 models use the device id as the account name, not "admin".
V380_USERNAME=admin
V380_PASSWORD=
# Per-camera overrides, keyed by device id: username, password, label, ip,
# port, quality, cloud, enabled. Optional; DATA_DIR/v380_cameras.json.
V380_CAMERAS_FILE=
# hd or sd. sd is markedly lighter and gives more frequent clean keyframes,
# which is what snapshots and recognition want.
V380_QUALITY=hd
# Live view: rtsp://<host>:8554/<device_id>, one path per camera.
V380_RTSP_ENABLED=true
V380_RTSP_PORT=8554
# UDP broadcast for cameras. Off means the fleet is exactly what the
# cameras file names.
V380_DISCOVERY_ENABLED=true
V380_DISCOVERY_INTERVAL=300
# How often each camera's still is refreshed, and how long a camera may go
# without a frame before it counts as offline.
V380_SNAPSHOT_INTERVAL=5
V380_OFFLINE_AFTER=45
# Clips the assistant may play through a camera speaker. Defaults to
# DATA_DIR/v380_audio; nothing outside this directory can be played.
V380_AUDIO_DIR=

# Voice
VOICE_ENABLED=false
# Trailing silence before an utterance is considered finished.
VOICE_END_SILENCE_MS=900
# Say "hang on" if a reply takes longer than this; 0 disables.
VOICE_FILLER_DELAY_S=3.0
# Mishearings of ASSISTANT_NAME to accept as the wake word.
# See: blackice wake-report
WAKE_ALIASES=
# faster-whisper size: tiny.en, base.en, small.en, medium.en, large-v3
VOICE_ASR_MODEL=small.en
VOICE_KEYBOARD_INTERRUPT=false
# Audio cues: wake | all | off
VOICE_CUE_MODE=wake
# Ignore our own voice heard back off the speaker for this long.
VOICE_ECHO_WINDOW_S=20
# Interrupt the assistant by talking over it. Needs headphones or
# echo cancellation; on open speakers it interrupts itself.
VOICE_BARGE_IN=false
# Spoken replies favour speed; blank uses MODEL_PRIMARY.
MODEL_VOICE=qwen3.5-9b
# Absolute path to a Piper .onnx voice; blank uses voice2's default location.
# en_GB-jenny_dioco-medium is the Jenny dataset: young female, Irish accent.
PIPER_VOICE=
